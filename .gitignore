# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/descai/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.csv

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (NEVER commit these - contain API keys)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js specific (from descai/.gitignore)
/descai/.next/
/descai/out/

# Local file storage (OUTDATED - now using Supabase Storage; uncomment if needed)
/descai/public/uploads/*
!/descai/public/uploads/.gitkeep
/descai/public/reviews/*
!/descai/public/reviews/.gitkeep

# Deployment artifacts
/dist
/build
s